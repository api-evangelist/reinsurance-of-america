{
  "@context": {
    "@version": 1.1,
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "finserv": "http://schema.org/",
    "rga": "https://rgare.com/vocab/",
    "RGAInsuranceProduct": {
      "@id": "rga:InsuranceProduct",
      "@type": "@id"
    },
    "Reinsurer": {
      "@id": "schema:FinancialService",
      "@type": "@id"
    },
    "name": {
      "@id": "schema:name"
    },
    "description": {
      "@id": "schema:description"
    },
    "riskScore": {
      "@id": "rga:riskScore",
      "@type": "xsd:decimal"
    },
    "underwritingCategory": {
      "@id": "rga:underwritingCategory"
    },
    "claimsData": {
      "@id": "rga:claimsData"
    },
    "medicalRecords": {
      "@id": "rga:medicalRecords"
    },
    "carrierSystem": {
      "@id": "rga:carrierSystem"
    },
    "policyType": {
      "@id": "rga:policyType"
    },
    "coverageAmount": {
      "@id": "schema:price",
      "@type": "xsd:decimal"
    },
    "issuedDate": {
      "@id": "schema:dateIssued",
      "@type": "xsd:dateTime"
    },
    "clientId": {
      "@id": "schema:identifier"
    }
  }
}
